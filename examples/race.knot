-- `race` smoke test.
--
-- Two IO actions sleep for different durations; the shorter sleep wins
-- and the loser's sleep is interrupted via its cancel-condvar so the
-- race returns close to the winner's wall-clock time rather than the
-- loser's.
with {
slow (do
  base.sleep (base.the (Int Ms) 1000)
  yield "slow")

fast (do
  base.sleep (base.the (Int Ms) 50)
  yield "fast")
}
(do
  start1 <- base.now
  r1 <- base.race slow fast
  end1 <- base.now
  ? (r1)
    Result.Err {error a}  base.println ("left won: " ++ a)
    Result.Ok {value b}  base.println ("right won: " ++ b)
  base.println ("  race 1 took " ++ base.show (base.stripUnit (end1 - start1)) ++ "ms")
  start2 <- base.now
  r2 <- base.race fast slow
  end2 <- base.now
  ? (r2)
    Result.Err {error a}  base.println ("left won: " ++ a)
    Result.Ok {value b}  base.println ("right won: " ++ b)
  base.println ("  race 2 took " ++ base.show (base.stripUnit (end2 - start2)) ++ "ms"))