with {
type Sale = {item: Text, qty: Int 1, price: Int 1}

*sales : [Sale]
}
(do
  full *sales = [
    { item "apple" qty 3 price 50 } 
    { item "banana" qty 7 price 20 } 
    { item "cherry" qty 2 price 120 } 
    { item "date" qty 5 price 80 } 
    { item "fig" qty 4 price 30 }
  ]

  -- Bind once so the source name resolves through source_var_binds
  sales <- *sales

  -- 1. fold over a bare source binding: total revenue across every row
  with { total (base.fold (\acc s -> acc + s.qty * s.price) 0 sales) } (do
    base.println ("total revenue: " ++ base.show total)

    -- 2. fold over a filter expression: revenue for high-qty items only
    with { bulk (base.fold (\acc s -> acc + s.qty * s.price) 0 (base.filter (\s -> s.qty > 3) sales)) } (do
      base.println ("bulk-only revenue: " ++ base.show bulk)

      -- 3. fold over a do-block (SQL plan): count rows priced > 25
      with { pricey (base.fold (\acc _ -> acc + 1) 0 do
        s <- sales
        where s.price > 25
        yield s) } (do
        base.println ("rows priced > 25: " ++ base.show pricey)

        yield {}))))
