-- Arithmetic-map aggregate pushdown: `rel |> map (\r -> <arith>) |> sum`
-- folds the arithmetic into the aggregate, emitting a single
-- `SELECT SUM(<arith>) FROM <table>` instead of shipping every row.
with {
Line  {product Text  price (Int 1)  qty (Int 1)}

Rel Line  *lines

totalDemo (|
  lines <- *lines
  -- Revenue per line is price*qty; the whole thing is one SQL SUM.
  base.println ("Total revenue " ++ base.show (*lines |> base.map (\l -> l.price * l.qty) |> base.sum)))

avgDemo (|
  lines <- *lines
  base.println ("Lines " ++ base.show (base.count lines)))
}

do
  full *lines = [{product "widget"  price 5  qty 2}  {product "gadget"  price 9  qty 1}  {product "gizmo"  price 5  qty 3}]
  totalDemo
  avgDemo
  yield {}
