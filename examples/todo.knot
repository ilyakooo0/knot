with {
Todo  {title Text  owner Text  done (Int 1)}

Rel Todo  *todos

_  add  (\title owner -> |
  todos <- *todos
  *todos = base.union todos [{title title  owner owner  done 0}])

_  complete  (\title -> |
  todos <- *todos
  *todos = |
    t <- todos
    yield (? (t.title == title)
      Bool.True {}  (base.unify t {done 1})
      Bool.False {}  t))

_  pending  (\owner ->
  with {todos *todos}
  (| t <- todos; where t.done == 0; where t.owner == owner; yield t.title))
}
(|
  add "Write parser" "Alice"
  add "Write codegen" "Alice"
  add "Write runtime" "Bob"
  complete "Write parser"
  result <- pending "Alice"
  base.println result)