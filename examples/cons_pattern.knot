-- Pattern-matching on relations with `[]` and `Cons head tail`.
with {
sumList (\xs -> match xs
  []  0
  Cons h t  h + sumList t)

firstOr (\xs default -> match xs
  []  default
  Cons h _  h)
}
(do
  base.println (base.show (sumList [1  2  3  4]))
  base.println (base.show (sumList []))
  base.println (base.show (firstOr [10  20  30] 0))
  base.println (base.show (firstOr [] 99))
  yield {})