-- A complete HTTP API server, showcasing the full `api` URL-template DSL.
--
-- Run: knot build examples/apiserver.knot -o /tmp/apiserver && /tmp/apiserver
-- Then, in another shell:
--   curl localhost:8080/tasks
--   curl localhost:8080/tasks/1
--   curl -X POST localhost:8080/tasks -d '{"title":"write docs","owner":"alice"}'
--   curl 'localhost:8080/search?q=docs&limit=5'
--   curl localhost:8080/tasks/1/audit -H 'authorization: Bearer ***'
--   curl -i -X POST localhost:8080/echo -d '{"title":"x","owner":"y"}'   # see X-Request-Id header
--   curl localhost:8080/summary
with {

Priority  Low {}  Medium {}  High {}  Critical {}

Active  Yes {}  No {}

Task  {id (Int 1)  title Text  owner Text  priority Priority  done Active}

Rel Task  *tasks

-- Every  route feature  on display:
--   List    —  plain GET,  returns a  relation.
--   Get     —  a path  parameter `{id (Int 1)}`.
--   Search  —  query parameters `?{q Text}&{limit (Int 1)}`.
--   Create  —  a request  body `={title Text  owner Text}`.
--   Echo    —  a request  body AND  a response  header `@{xRequestId Text}`; the
--             handler returns `{body,  headers}` when  response headers  exist.
--   Audit   —  a request  header `@{authorization Text}` (before the `->`).
--   Summary —  a rate  limit `rateLimit {key limit {requests, window}}`.
-- NOTE  on path  shapes the  router matches  entries in  declaration order  and
--  returns the  first hit,  so a  literal segment (`/tasks/search`)  at the  same
--  depth as  a parameter (`/tasks/{id}`)  is shadowed  by the  parameter. Put
--  literal-only routes  on their  own prefixes (`/search`, `/summary`, `/echo`)
--  rather than  alongside a `{param}`  sibling.
api Tasks where
  List    get  /tasks -> Rel Task
  Get     get  /tasks/{id (Int 1)} -> Rel Task
  Search  get  /search?{q Text}&{limit (Int 1)} -> Rel Task
  Create  post /tasks ={title Text  owner Text} -> Task
  Echo    post /echo ={title Text  owner Text} -> Task @{xRequestId Text}
  Audit   get  /tasks/{id (Int 1)}/audit @{authorization Text} -> Rel Task
  Summary  get  /summary -> Int 1
    _  key
    rateLimit {key (\i c -> Maybe.Just {value "global"})
               limit {requests 100  window 60000}}

nextId (\rows -> match (rows)
  []  1
  Cons _ _  base.count rows + 1)

addTask (\title owner -> do
  rows <- *tasks
  with {id (nextId rows)}
    (*tasks = base.union rows [{id id  title title  owner owner  priority (Priority.Medium {})  done (Active.No {})}]))

findById (\tid rows -> base.filter (\t -> t.id == tid) rows)

srv (< Tasks
  List = \{} -> do
    rows <- *tasks
    yield (Result.Ok {value rows})

  Get = \{id id} -> do
    rows <- *tasks
    yield (Result.Ok {value (findById id rows)})

  Search = \{q q  limit limit} -> do
    rows <- *tasks
    base.println ("search q=" ++ q ++ " limit=" ++ base.show limit)
    yield (Result.Ok {value rows})

  Create = \{title title  owner owner} -> do
    addTask title owner
    yield (Result.Ok {value {id 0  title title  owner owner  priority (Priority.Medium {})  done (Active.No {})}})

  Echo = \{title title  owner owner} ->
    -- Response headers declared → the handler returns {body, headers}.
    yield (Result.Ok {value {body {id 0  title title  owner owner  priority (Priority.Low {})  done (Active.No {})}
                             headers {xRequestId "req-echo-1"}}})

  Audit = \{id id  authorization authorization} -> do
    base.println ("audit for task " ++ base.show id ++ " with auth " ++ authorization)
    rows <- *tasks
    yield (Result.Ok {value (findById id rows)})

  Summary = \{} -> do
    rows <- *tasks
    yield (Result.Ok {value (base.count rows)}))

}
(base.listen 8080 srv)