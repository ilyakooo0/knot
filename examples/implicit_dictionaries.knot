-- Implicit dictionaries: `(base.the (T) ^field) =>` signature constraints.
--
-- `clamp` needs a `compare` dictionary but doesn't name it. The compiler
-- resolves the dictionary from lexical scope at each full-arity callsite.
with {
intOrd {compare (\a b -> ? (a > b)
  Bool.True {}  1
  Bool.False {}  ? (a < b)
    Bool.True {}  (0 - 1)
    Bool.False {}  0)}
textOrd {compare (\a b -> ? (a > b)
  Bool.True {}  1
  Bool.False {}  ? (a < b)
    Bool.True {}  (0 - 1)
    Bool.False {}  0)}
intOrdDesc {compare (\a b -> ? (a < b)
  Bool.True {}  1
  Bool.False {}  ? (a > b)
    Bool.True {}  (0 - 1)
    Bool.False {}  0)}

((a -> a -> Int 1)  ^compare) =>  a ->  a ->  a ->  a  clamp  (\lo hi x -> ? ((^compare) x lo) < 0
  Bool.True {}  lo
  Bool.False {}  ? ((^compare) x hi) > 0
    Bool.True {}  hi
    Bool.False {}  x)
}
(do
    base.println (base.show (with intOrd (clamp 0 10 42)))
    base.println (base.show (with textOrd (clamp "a" "m" "z")))
    base.println (base.show (with intOrdDesc (clamp 0 10 42))))