with {
Todo  {title Text  owner Text  done (Int 1)}

Rel Todo  *todos

add (\title owner -> do
  todos <- *todos
  *todos = base.union todos [{title title  owner owner  done 0}])

complete (\title -> do
  todos <- *todos
  *todos = do
    t <- todos
    yield (match t.title == title
      Bool.True {}  (base.unify t {done 1})
      Bool.False {}  t))

pending (\owner ->
  with {todos *todos}
  (do t <- todos; where t.done == 0; where t.owner == owner; yield t.title))
}
(do
  add "Write parser" "Alice"
  add "Write codegen" "Alice"
  add "Write runtime" "Bob"
  complete "Write parser"
  result <- pending "Alice"
  base.println result)