-- Verifies that SQL pushdown matchers fold through `with` bindings.
-- Each pattern below stores its rewrite in a local `with` record first; the
-- compiler inlines the bound body when matching the set/replace shape.
with {
Item  {name Text  price (Int 1)}

Rel Item  *items

-- Append `union  items new`  hidden behind  a with.
appendDemo (do
  items <- *items
  with {extra [{name "Charlie"  price 30}]} with {merged (base.union items extra)} *items = merged)

-- Conditional  update do-block  update body  bound to  a with.
discountDemo (do
  items <- *items
  with {discounted (do
    i <- items
    yield (case i.price > 20 of
      Bool.True {} -> (base.unify i {price (i.price - 5)})
      Bool.False {} -> i))} *items = discounted)

-- Filter  only do-block  filter body  bound to  a with.
pruneDemo (do
  items <- *items
  with {kept (do i <- items; where i.price > 0; yield i)} *items = kept)
}
(do
  full *items = [{name "Alice"  price 10}  {name "Bob"  price 25}]
  appendDemo
  rows1 <- *items
  base.println ("after append: " ++ base.show rows1)
  discountDemo
  rows2 <- *items
  base.println ("after discount: " ++ base.show rows2)
  pruneDemo
  rows3 <- *items
  base.println ("after prune: " ++ base.show rows3)
  yield {})
