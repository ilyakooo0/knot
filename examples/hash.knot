-- Hash builtin smoke-test (BLAKE3, polymorphic over any value)

(do
  -- Bytes: BLAKE3 of "abc" — expected 6437b3ac...9d85
  base.println (base.bytesToHex (base.hash (base.textToBytes "abc")))

  -- Bytes: BLAKE3 of empty bytes — expected af1349b9...3262
  base.println (base.bytesToHex (base.hash b""))

  -- Text: hashes raw UTF-8 bytes (same digest as bytes form above)
  base.println (base.bytesToHex (base.hash "abc"))

  -- Records: equal records hash equal
  base.println (base.bytesToHex (base.hash { x 1 y 2 }))
  base.println (base.bytesToHex (base.hash { x 1 y 2 }))

  -- Different records hash differently
  base.println (base.bytesToHex (base.hash { x 1 y 3 }))

  -- Numbers, booleans, lists also work
  base.println (base.bytesToHex (base.hash 42))
  base.println (base.bytesToHex (base.hash (Bool.True {})))
  base.println (base.bytesToHex (base.hash [1, 2, 3]))

  yield {})
