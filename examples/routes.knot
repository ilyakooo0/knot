with {
Priority  Low {}  Medium {}  High {}  Critical {}

Todo  {title Text  owner Text  priority Priority}

Rel Todo  *todos

api Api where
  GetTodos  get /todos/{owner Text} @{xForwardedFor (Maybe Text)} -> Rel Todo
  CreateTodo  post /todos ={title Text  owner Text  priority Text} -> Todo
  GetCount  get /admin/count -> Int 1

_  addTodo
addTodo (\title owner priority -> do
  rows <- *todos
  *todos = base.union rows [{title title  owner owner  priority (Priority.Low {})}])

srv (serve Api where
  GetTodos = \{owner owner  xForwardedFor xForwardedFor} -> do
    match xForwardedFor
      Maybe.Just {value ip}  base.info ("GetTodos from " ++ ip)
      Maybe.Nothing {}  base.info "GetTodos (no proxy header)"
    rows <- *todos
    with {matching (base.filter (\t -> t.owner == owner) rows)} (do
      match base.count matching == 0
        Bool.True {}  yield (Result.Err {error {status 404  message "no todos found for owner"}})
        Bool.False {}  yield (Result.Ok {value matching}))
  CreateTodo = \{title title  owner owner  priority priority} -> do
    addTodo title owner priority
    yield (Result.Ok {value {title title  owner owner  priority (Priority.Low {})}})
  GetCount = \{} -> do
    rows <- *todos
    yield (Result.Ok {value (base.count rows)}))
}
(base.listen 8080 srv)