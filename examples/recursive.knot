-- Query fields: read-only computed views over source relations.
-- A `name <query>` field is recomputed on each access — never persisted.
with {
Rel {manager Text  report Text}  *manages

directReports (|
  m <- *manages
  yield {manager m.manager  report m.report})
}
(|
  *manages = [
    {manager "Alice"  report "Bob"}
    {manager "Alice"  report "Carol"}
    {manager "Bob"  report "Dave"}
  ]
  base.println "Direct reports:"
  rows <- base.run [] directReports
  base.println (base.show rows)
  base.println ("Total: " ++ base.show (base.count directReports))
  yield {})
