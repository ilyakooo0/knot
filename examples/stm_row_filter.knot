-- STM row-level filtering smoke test.
--
-- Demonstrates the row-level filtering optimization: workers retrying on
-- `WHERE id = ?` are only woken when a write affects their specific row.
-- Verification of selective wakeup behavior is covered in the runtime unit
-- tests (`_stm_filter_tests` in knot-runtime). This program exists primarily
-- as an end-to-end compile/run check on the codegen specialization path.
with {
Account  {id (Int 1)  balance (Int 1)}
Rel Account  *accounts

_  findById  (\aid rows -> base.filter (\a -> a.id == aid) rows)

_  setBalance  (\aid newBalance rows -> |
  r <- rows
  yield (? (r.id == aid)
    Bool.True {}  (base.unify r {balance newBalance})
    Bool.False {}  r))

_  credit  (\aid amount -> atomic |
  rows <- *accounts
  -- The `single (filter ...)` lookup is what the runtime SQL pushdown turns
  -- into a `WHERE "id" = ?` query — codegen extracts the predicate and the
  -- runtime calls `knot_stm_track_read_pred` to register a row-level filter.
  with {  lookup (findById aid rows) }
    (*accounts = setBalance aid amount rows))
}
(|
  *accounts = [{id 1  balance 0}  {id 2  balance 0}  {id 3  balance 0}]
  credit 1 100
  credit 2 50
  credit 3 25
  rows <- *accounts
  base.println ("final: " ++ base.show rows)
  yield {})