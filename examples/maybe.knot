-- Monadic do-blocks with Maybe
--
-- Maybe's monad operations are intrinsic builtins (Functor/Applicative/Monad/
-- Alternative were removed with the trait system). Do-blocks over Maybe
-- dispatch structurally to the intrinsic Maybe bind/yield/empty.
with {
-- Test  a simple  do-block that  uses Maybe  as the  monad
_  safeDivide  (\x y -> ? (y == 0)
  Bool.True {}  Maybe.Nothing {}
  Bool.False {}  Maybe.Just {value (x / y)})

result1 (do
  a <- Maybe.Just {value 10}
  b <- Maybe.Just {value 2}
  c <- safeDivide a b
  yield c)

result2 (do
  a <- Maybe.Just {value 10}
  b <- Maybe.Just {value 0}
  c <- safeDivide a b
  yield c)

-- Test where  clause (uses empty for filtering)
result3 (do
  a <- Maybe.Just {value 10}
  b <- Maybe.Just {value 3}
  where b > 2
  yield (a + b))

result4 (do
  a <- Maybe.Just {value 10}
  b <- Maybe.Just {value 1}
  where b > 2
  yield (a + b))
}
(do
  base.println (base.show result1)
  base.println (base.show result2)
  base.println (base.show result3)
  base.println (base.show result4)
  yield {})