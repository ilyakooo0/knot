-- `Ord` as a record dictionary, and a function generic over "any type with
-- an Ord instance".
--
-- The post-trait idiom: an `Ord` "instance" is a record of functions. A
-- function that works for any ordered type takes that record as an explicit
-- parameter and calls its fields with `ord.compare` / `ord.max`.
with {
-- compare a b == 1 when a > b, -1 when a < b, 0 when equal.
intOrd {
  compare (\a b -> case a > b of
    true -> 1
    false -> case a < b of
      true -> (0 - 1)
      false -> 0)
  max     (\a b -> case a > b of
    true -> a
    false -> b)
}

textOrd {
  compare (\a b -> case a > b of
    true -> 1
    false -> case a < b of
      true -> (0 - 1)
      false -> 0)
  max     (\a b -> case a > b of
    true -> a
    false -> b)
}

-- A different ordering for the same type: descending.
intOrdDesc {
  compare (\a b -> case a < b of
    true -> 1
    false -> case a > b of
      true -> (0 - 1)
      false -> 0)
  max     (\a b -> case a < b of
    true -> a
    false -> b)
}

-- `clamp lo hi ord x` is generic: pass any type's Ord dictionary.
clamp (\lo hi ord x ->
  case ((ord.compare x lo) == (0 - 1)) of
    true -> lo
    false -> case ((ord.compare x hi) == 1) of
      true -> hi
      false -> x)
}
(do
  -- Same function, different types — just different dictionaries.
  base.println (base.show (clamp 0 10 intOrd 42))          -- 10  (Int, clamped high)
  base.println (base.show (clamp 0 10 intOrd 3))           -- 3   (Int, in range)
  base.println (clamp "a" "m" textOrd "zebra")        -- "m" (Text, clamped high)

  -- Swap the dictionary to change the ordering: descending "max" is the min.
  base.println (base.show (clamp 0 10 intOrdDesc 42))      -- 0
  base.println (base.show ((intOrd.max) 3 7))              -- 7  (ascending max)
  base.println (base.show ((intOrdDesc.max) 3 7))          -- 3  (descending "max")
  yield {})
