with {
safeDiv : Int 1 -> Int 1 -> Maybe (Int 1)
safeDiv (\x y -> case y == 0 of
  Bool.True {} -> Maybe.Nothing {}
  Bool.False {} -> Maybe.Just {value (x / y)})

nums [1, 2, 3, 4, 5]

doubled (base.map (\n -> n * 2) nums)
total (base.fold (\acc n -> acc + n) 0 nums)
evens (base.filter (\n -> n % 2 == 0) nums)

divChain (do
  a <- safeDiv 20 4
  b <- safeDiv a 0
  yield (b + 1))

divOk (do
  a <- safeDiv 20 4
  b <- safeDiv a 5
  yield b)
}
(do
  base.println ("doubled: " ++ base.show doubled)
  base.println ("total:   " ++ base.show total)
  base.println ("evens:   " ++ base.show evens)
  base.println ("first2:  " ++ base.show (base.take 2 nums))
  base.println ("drop2:   " ++ base.show (base.drop 2 nums))
  base.println ("head:    " ++ base.show (base.head nums))
  base.println ("find>3:  " ++ base.show (base.findFirst nums (\n -> n > 3)))
  base.forEach nums (\n -> base.println ("  item " ++ base.show n))
  base.println ("divChain (hits Nothing): " ++ base.show divChain)
  base.println ("divOk:                   " ++ base.show divOk)
  yield {})
